---
interface Props {
  formId?: number;
  title?: string;
  subtitle?: string;
  buttonText?: string;
}

const {
  formId = 4,
  title = "Get Your Free Quote & Consultation",
  subtitle = "Lock in rebates & lower your monthly utility bill today.",
  buttonText = "Request Free Estimate"
} = Astro.props;
---

<div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-gray-100 relative overflow-hidden" id="quote">
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#92d94d] to-[#1a7efb]"></div>

  <div class="mb-6">
    <h3 class="text-2xl font-bold text-gray-900 tracking-tight">{title}</h3>
    <p class="text-sm text-gray-600 mt-1">{subtitle}</p>
  </div>

  <form id={`lead-form-${formId}`} class="space-y-4" data-form-id={formId}>
    <!-- Hidden GCLID and Form ID fields for Google Ads conversion tracking -->
    <input type="hidden" name="gclid" id="gclid-field" value="" />
    <input type="hidden" name="form_id" value={formId} />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="first_name" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">First Name *</label>
        <input 
          type="text" 
          id="first_name" 
          name="first_name" 
          required 
          placeholder="John" 
          class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#92d94d] focus:border-transparent text-gray-900 text-sm outline-none transition"
        />
      </div>
      <div>
        <label for="last_name" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Last Name *</label>
        <input 
          type="text" 
          id="last_name" 
          name="last_name" 
          required 
          placeholder="Doe" 
          class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#92d94d] focus:border-transparent text-gray-900 text-sm outline-none transition"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="phone" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Phone Number *</label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          required 
          placeholder="(818) 000-0000" 
          class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#92d94d] focus:border-transparent text-gray-900 text-sm outline-none transition"
        />
      </div>
      <div>
        <label for="email" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Email Address *</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="john@example.com" 
          class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#92d94d] focus:border-transparent text-gray-900 text-sm outline-none transition"
        />
      </div>
    </div>

    <div>
      <label for="service" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Primary Service Needed</label>
      <select 
        id="service" 
        name="service" 
        class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#92d94d] focus:border-transparent text-gray-900 text-sm outline-none transition bg-white"
      >
        <option value="Solar Energy">Solar Energy & Battery</option>
        <option value="Roof Replacement">Roof Replacement & Repair</option>
        <option value="Cool Wall Paint">Cool Wall Paint & Coating</option>
        <option value="Home Insulation">Home Insulation</option>
        <option value="Windows & Doors">Windows & Doors</option>
        <option value="Other">Whole Home Efficiency / Other</option>
      </select>
    </div>

    <div>
      <label for="message" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Project Details / Notes (Optional)</label>
      <textarea 
        id="message" 
        name="message" 
        rows="2" 
        placeholder="Tell us about your home or project..." 
        class="w-full px-3.5 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#92d94d] focus:border-transparent text-gray-900 text-sm outline-none transition"
      ></textarea>
    </div>

    <div class="pt-2">
      <button 
        type="submit" 
        class="w-full py-3.5 px-6 rounded-xl text-base font-bold text-[#1d211f] bg-[#92d94d] hover:bg-[#7ec438] active:scale-[0.99] shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>{buttonText}</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>

    <p class="text-xs text-gray-400 text-center mt-3">
      🔒 Your information is confidential. No spam, ever.
    </p>

    <!-- Success Message Container -->
    <div id={`form-success-${formId}`} class="hidden p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 text-sm mt-4 text-center">
      <p class="font-bold text-base mb-1">🎉 Thank you! We received your request.</p>
      <p>One of our energy specialists will contact you shortly to confirm your estimate.</p>
    </div>
  </form>
</div>

<script define:vars={{ formId }}>
  // Automatically capture GCLID from URL parameters and store in hidden field and sessionStorage
  function captureGclid() {
    const urlParams = new URLSearchParams(window.location.search);
    const gclid = urlParams.get('gclid');
    if (gclid) {
      sessionStorage.setItem('gclid', gclid);
    }
    const savedGclid = gclid || sessionStorage.getItem('gclid') || '';
    const gclidInput = document.getElementById('gclid-field');
    if (gclidInput) {
      gclidInput.value = savedGclid;
    }
  }

  // Handle form submission and push conversion event to dataLayer
  function setupForm() {
    captureGclid();
    const form = document.getElementById(`lead-form-${formId}`);
    const successBox = document.getElementById(`form-success-${formId}`);

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Push event to dataLayer for Google Tag Manager & Google Ads
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'fluentform_submission_success',
          form_id: formId,
          form_name: formId === 9 ? 'Contact Page Form' : 'Service Page Form',
          gclid: data.gclid || '',
          email: data.email || '',
          phone: data.phone || ''
        });

        console.log('Conversion pushed to dataLayer:', {
          event: 'fluentform_submission_success',
          form_id: formId,
          gclid: data.gclid
        });

        // Display success confirmation
        if (successBox) {
          successBox.classList.remove('hidden');
          form.reset();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupForm);
  } else {
    setupForm();
  }
</script>
