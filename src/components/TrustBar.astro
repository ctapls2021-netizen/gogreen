---
---

<section class="bg-gray-50 border-y border-gray-100 py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center text-center">
      
      <!-- Item 1: License -->
      <div class="flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#92d94d]/15 flex items-center justify-center text-[#7ec438] flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div class="text-left">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Licensed & Insured</p>
          <a 
            href="https://www.cslb.ca.gov/OnlineServices/CheckLicenseII/LicenseDetail.aspx?LicNum=1064369" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-sm font-bold text-gray-900 hover:text-[#7ec438] transition-colors"
          >
            CSLB #1064369
          </a>
        </div>
      </div>

      <!-- Item 2: Tesla Certified -->
      <div class="flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#1d211f]/10 flex items-center justify-center text-gray-900 flex-shrink-0">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="text-left">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Certified Partner</p>
          <p class="text-sm font-bold text-gray-900">Tesla Certified Installer</p>
        </div>
      </div>

      <!-- Item 3: Experience -->
      <div class="flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[#1a7efb]/15 flex items-center justify-center text-[#1a7efb] flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-left">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Proven Experience</p>
          <p class="text-sm font-bold text-gray-900">15+ Years in SoCal</p>
        </div>
      </div>

      <!-- Item 4: Financing -->
      <div class="flex items-center justify-center gap-3">
        <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-left">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Rebates & Rates</p>
          <p class="text-sm font-bold text-gray-900">0% Down Financing</p>
        </div>
      </div>

    </div>
  </div>
</section>
