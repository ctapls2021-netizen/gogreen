---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import globalHead from '../data/globalHead.html?raw';
import footerScripts from '../data/footerScripts.html?raw';

interface Props {
  title?: string;
}

const { title = "GoGreen Builders - Sustainable Home Energy Solutions" } = Astro.props;
---
<!DOCTYPE html>
<html dir="ltr" lang="en-US" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
  <title>{title}</title>
  <style>
    
    html { margin-top: 0px !important; }
    
  </style>
  <slot name="head" />
  <Fragment set:html={globalHead} />
</head>
<body itemtype="https://schema.org/WebPage" itemscope="itemscope" class="site-wrapper">
  <Header />
  <slot />
  <Footer />
  <Fragment set:html={footerScripts} />
</body>
</html>
